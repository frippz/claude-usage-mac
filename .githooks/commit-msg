#!/bin/sh
# Refuses a commit message whose subject is not a Conventional Commit with
# one of the repo's types and a summary starting lower case; see
# AGENTS.md#git-workflow. A merge keeps its default "Merge ..." subject.
subject=$(grep -v '^#' "$1" | grep -m 1 -v '^[[:space:]]*$')
types='feat|fix|perf|docs|refactor|test|build|ci|chore|revert'

case "$subject" in
  Merge\ *) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([^()]+\))?!?: [^A-Z[:space:]]"; then
  echo "Refused: \"$subject\" is not <type>(<optional scope>): <summary starting lower case>, with type one of ${types}. See AGENTS.md#git-workflow." >&2
  exit 1
fi
