#!/bin/sh
# Refuses a commit on main; see AGENTS.md#git-workflow. Also run as
# pre-merge-commit, so a merge on main is refused too.
if [ "$(git symbolic-ref --short -q HEAD)" = "main" ]; then
  echo "Refused: never commit to main. Work on an agent/ branch in its own worktree; see AGENTS.md#git-workflow." >&2
  exit 1
fi
